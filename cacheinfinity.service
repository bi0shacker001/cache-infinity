[Unit]
Description=CacheInfinity WebDAV Service
After=network.target

[Service]
Type=simple
User=cache-infinite
Group=cache-infinite
ExecStart=/usr/bin/env cacheinfinity serve --config-dir /etc/cacheinfinity/config
Restart=on-failure
Environment=PYTHONUNBUFFERED=1
# Hardening
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/cacheinfinity /var/log/cacheinfinity

# Rclone is now a mandatory dependency for CacheInfinity
# Ensure rclone-python is installed in the Python environment:
# pip install rclone-python
# Also ensure Rclone remotes are configured via the WebUI before starting the service

[Install]
WantedBy=multi-user.target
